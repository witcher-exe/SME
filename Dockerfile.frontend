# Dockerfile.frontend
FROM node:20-alpine

WORKDIR /app

# Copy dependency definitions
COPY frontend/package*.json ./
RUN npm install

# Copy application source
COPY frontend/ ./

ENV PORT=3000 \
    HOST=0.0.0.0 \
    VITE_BACKEND_URL=http://backend:8000

EXPOSE 3000

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]
