# AuraCFO Environment Configuration

# LLM Configuration
# Set to 'true' for offline / competition judging mode without API key
MOCK_LLM=true
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# Database Configuration
# Dev default: SQLite with async support
DATABASE_URL=sqlite+aiosqlite:///./auracfo.db
# Prod Docker default:
# DATABASE_URL=postgresql+asyncpg://auracfo:auracfo_password@db:5432/auracfo

# Security & PII Protection
# Salt for HMAC token generation of sensitive entities (names, accounts, TIN)
HMAC_SECRET_KEY=auracfo-super-secret-hmac-salt-key-2026

# Server & CORS
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Frontend (Vite)
VITE_API_URL=http://localhost:8000
